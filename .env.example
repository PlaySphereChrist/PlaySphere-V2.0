# Environment Variables — PlaySphere

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
# Set DATABASE_URL instead of the individual DB_* values if preferred.
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/playsphere
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playsphere
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Frontend origin allowed by the API's CORS policy
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

# ─────────────────────────────────────────────
# Razorpay
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────
# Email (optional — Nodemailer)
# ─────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="PlaySphere" <noreply@playsphere.local>

# ─────────────────────────────────────────────
# AI Services (Copilot & Moderation)
# ─────────────────────────────────────────────
# Gemini API (Recommended): https://aistudio.google.com
GEMINI_API_KEY=
# Or OpenAI API: https://platform.openai.com
OPENAI_API_KEY=

